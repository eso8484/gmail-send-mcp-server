# ─────────────────────────────────────────────────────────────
# Gmail Send MCP Server — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Get these from Google Cloud Console → APIs & Services → Credentials
GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret_here

# Generate this by running: npm run get-token
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Your Gmail address (used as the "From" field)
GMAIL_USER_EMAIL=you@gmail.com

# Optional: "stdio" (default, for Claude Desktop) or "http"
TRANSPORT=stdio

# Optional: Port for HTTP transport mode (default: 3000)
PORT=3000
